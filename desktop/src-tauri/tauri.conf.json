{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Eavesy",
  "version": "0.2.0",
  "identifier": "com.eavesy.desktop",
  "build": {
    "frontendDist": "frontend-shell",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "bun install && bun run dev",
      "cwd": "../launcher-ui"
    },
    "beforeBuildCommand": {
      "script": "sh scripts/prebuild.sh",
      "cwd": ".."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Eavesy",
        "label": "main",
        "url": "index.html",
        "width": 420,
        "height": 440,
        "minWidth": 360,
        "minHeight": 320,
        "center": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "shadow": true,
        "visible": false,
        "focus": false,
        "maxWidth": 960,
        "maxHeight": 1200
      },
      {
        "title": "Eavesy Recording",
        "label": "hud",
        "url": "hud.html",
        "width": 272,
        "height": 40,
        "minWidth": 196,
        "minHeight": 36,
        "maxWidth": 560,
        "maxHeight": 200,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "shadow": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/SwiftAudio"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "exceptionDomain": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwRjI3RTA2RDQ3N0I3MDQKUldRRXQzZlVCbjd5d0FUZC96djBqcVlSL25xbFozSXhBTWlPbStvamVod2tHR1V6Sk5mVDJWZWUK",
      "endpoints": [
        "https://eavesy.com/api/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
