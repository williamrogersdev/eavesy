{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eavesy",
  "account_id": "5bc563d42299762f9b48f5dec0531954",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  "placement": { "mode": "smart" },

  "routes": [
    { "pattern": "eavesy.com", "custom_domain": true },
    { "pattern": "www.eavesy.com", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eavesy",
      "database_id": "72c5c5f6-a2d9-4a07-b17f-15eb282e9782",
      "migrations_dir": "./drizzle"
    }
  ],

  "r2_buckets": [{ "binding": "AUDIO_BUCKET", "bucket_name": "eavesy-audio" }],

  "kv_namespaces": [
    { "binding": "CACHE", "id": "747194bd464a41259c256bba5181f6e7" }
  ],

  "queues": {
    "producers": [{ "queue": "eavesy-processing", "binding": "PROCESSING_QUEUE" }]
  },

  "durable_objects": {
    "bindings": [{ "name": "DROPS_HUB", "class_name": "DropsHub" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DropsHub"] }],

  "vectorize": [{ "binding": "VECTORIZE", "index_name": "eavesy-embeddings" }],

  "ai": { "binding": "AI" },

  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://eavesy.com"
  },

  "env": {
    "preview": { "name": "eavesy-preview" }
  }
}
