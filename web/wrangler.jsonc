{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eavesy",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  "placement": { "mode": "smart" },

  "routes": [
    { "pattern": "app.example.invalid", "custom_domain": true },
    { "pattern": "www.example.invalid", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eavesy",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./drizzle"
    }
  ],

  "r2_buckets": [{ "binding": "AUDIO_BUCKET", "bucket_name": "eavesy-audio" }],

  "kv_namespaces": [
    { "binding": "CACHE", "id": "00000000000000000000000000000000" }
  ],

  "queues": {
    "producers": [{ "queue": "eavesy-processing", "binding": "PROCESSING_QUEUE" }]
  },

  // Notetaker bots (workers/meeting-bot); deployed before this Worker.
  "services": [{ "binding": "MEETING_BOTS", "service": "eavesy-meeting-bot", "entrypoint": "BotControl" }],

  "durable_objects": {
    "bindings": [{ "name": "DROPS_HUB", "class_name": "DropsHub" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DropsHub"] }],

  "vectorize": [{ "binding": "VECTORIZE", "index_name": "eavesy-embeddings" }],

  "ai": { "binding": "AI" }
}
