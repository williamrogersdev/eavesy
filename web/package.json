{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "../scripts/cf sh -c \"vite build && wrangler deploy ${RELEASE:+--var RELEASE:$RELEASE} ${POSTHOG_KEY:+--var POSTHOG_KEY:$POSTHOG_KEY}\"",
    "cf-typegen": "wrangler types",
    "lint": "eslint",
    "typecheck": "tsrs --noEmit",
    "test": "bun run test:unit && bun run test:workers",
    "test:ux": "playwright test --config playwright.ux.config.ts",
    "test:unit": "bun test src",
    "test:workers": "tsrs --noEmit -p test/tsconfig.json && vitest run --config vitest.workers.config.ts",
    "typecheck:tsrs": "tsrs --noEmit",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@clerk/tanstack-react-start": "^1.7.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.57.0",
    "posthog-js": "1.438.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "workers-og": "^0.0.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
