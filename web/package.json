{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "../scripts/cf sh -c \"vite build && wrangler deploy\"",
    "cf-typegen": "wrangler types",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:workers",
    "test:ux": "playwright test --config playwright.ux.config.ts",
    "test:unit": "bun test src",
    "test:workers": "tsc --noEmit -p test/tsconfig.json && vitest run --config vitest.workers.config.ts",
    "stripe:setup": "bun run scripts/setup-stripe.ts"
  },
