VITE_CLERK_PUBLISHABLE_KEY=
VITE_APP_URL=http://localhost:3000

VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Optional browser error reporting (Sentry). Leave empty to disable; the SDK
# is not loaded at all without a DSN. Events are scrubbed before sending (see
# docs/OBSERVABILITY.md). VITE_SENTRY_RELEASE is set by CI to the git SHA.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

ANTHROPIC_API_KEY=

OPENAI_API_KEY=

# Local setup: copy this file to web/.env (dev) and fill in the values.
# For a production build run locally (`bun run build`), vite also reads
# web/.env.production, which is untracked. Create it with at least
# VITE_CLERK_PUBLISHABLE_KEY and VITE_APP_URL; CI writes a placeholder
# key and deploy.yml writes the real one from repository variables
# (see docs/DEPLOY.md).
