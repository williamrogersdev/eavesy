{
  "name": "@eavesy/cli",
  "version": "0.1.0",
  "description": "Search your local Eavesy captures (meetings, clipboard notes, screenshots) from the terminal or any MCP client.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamrogersdev/eavesy.git",
    "directory": "cli"
  },
  "homepage": "https://eavesy.com/docs/local-cli",
  "keywords": ["eavesy", "mcp", "cli", "notes", "meetings"],
  "bin": {
    "eavesy": "dist/eavesy.js"
  },
  "files": ["dist/eavesy.js", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/bin.ts --target node --outfile dist/eavesy.js",
    "compile": "bun build src/bin.ts --compile --minify --outfile dist/eavesy",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
