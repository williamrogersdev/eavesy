{
  "name": "@eavesy/cli",
  "version": "0.1.0",
  "description": "Search your local Eavesy captures (meetings, clipboard notes, screenshots) from the terminal or any MCP client. Read-only.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamrogersdev/eavesy.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/williamrogersdev/eavesy/tree/main/cli#readme",
  "keywords": [
    "eavesy",
    "mcp",
    "cli",
    "notes",
    "meetings"
  ],
  "bin": {
    "eavesy": "dist/eavesy.js"
  },
  "files": [
    "dist/eavesy.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/bin.ts --target node --outfile dist/eavesy.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
