{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "drizzle-orm": ["../../web/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../../web/node_modules/drizzle-orm/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../web/src/db/schema.ts",
    "../../web/src/lib/ai/embed.ts"
  ]
}
