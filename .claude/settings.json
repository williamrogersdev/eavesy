{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git merge origin/main)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr update-branch:*)",
      "Bash(gh pr merge * --auto *)",
      "Bash(gh pr merge * --disable-auto)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh run rerun:*)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun run build)",
      "Bash(bun run test:workers)",
      "Bash(bun run test:ux)",
      "Bash(bun run cf:restore)",
      "Bash(bun test:*)",
      "Bash(bun bench/score.ts --check)",
      "Bash(bunx tsc --noEmit)",
      "Bash(bunx eslint:*)",
      "Bash(bunx wrangler deploy --dry-run:*)",
      "Bash(bunx wrangler d1 migrations apply eavesy --local)",
      "Bash(cargo test --locked)",
      "Bash(swift test)",
      "Bash(scripts/check-migrations.sh)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(git push --tags:*)",
      "Bash(bunx wrangler deploy)",
      "Bash(bunx wrangler secret:*)",
      "Bash(bunx wrangler d1 migrations apply eavesy --remote:*)"
    ]
  }
}
